{
  "name": "gif2vid-site",
  "version": "1.0.0",
  "description": "A simple web application to convert GIF images to MP4 videos",
  "type": "module",
  "scripts": {
    "build": "npm run build:main && npm run build:site && npm run build:worker",
    "build:main": "esbuild main.ts --bundle --outfile=dist/main.js --format=esm",
    "build:worker": "esbuild worker.ts --bundle --outfile=dist/worker.js --format=esm",
    "build:site": "bun run scripts/build-site.ts",
    "translate:pages": "source openai.env && bun run scripts/translate-pages.ts",
    "watch": "npm run build -- --watch",
    "serve": "npx serve . -p 3340",
    "generate-icons": "node scripts/generate-icons.js"
  },
  "dependencies": {
    "gif2vid": "^0.0.5"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "gray-matter": "^4.0.3",
    "node-html-parser": "^7.0.0",
    "openai": "^6.39.0",
    "prettier": "^3.8.3",
    "sharp": "^0.34.4",
    "typescript": "^5.7.2"
  }
}
